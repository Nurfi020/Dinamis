generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  phone         String
  role          String     @default("Senior Sales Executive")
  monthlyTarget Int        @default(20)
  avatarUrl     String?
  passwordHash  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  leads         Lead[]
  followUps     FollowUp[]

  @@map("users")
}

model Product {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads     Lead[]

  @@map("products")
}

model Lead {
  id               String     @id @default(cuid())
  salesId          String
  name             String
  phone            String
  city             String
  source           String     // WhatsApp, Facebook, Instagram, TikTok, Website, Referral, Marketplace, Lainnya
  productId        String
  status           String     @default("Cold") // Cold, Warm, Hot, Closing, Tidak Berhasil
  initialNotes     String?
  lostReason       String?    // Harga terlalu mahal, Memilih kompetitor, Tidak membutuhkan produk, dll.
  lastFollowUpDate String?
  nextFollowUpDate String?
  nextFollowUpTime String?
  closedAt         DateTime?
  lostAt           DateTime?
  isDeleted        Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  sales            User       @relation(fields: [salesId], references: [id])
  product          Product    @relation(fields: [productId], references: [id])
  followUps        FollowUp[]

  @@map("leads")
}

model FollowUp {
  id               String   @id @default(cuid())
  leadId           String
  salesId          String
  date             String   // YYYY-MM-DD
  time             String   // HH:mm
  method           String   // WhatsApp, Telepon, Meeting, Email, Lainnya
  result           String   // Tertarik, Minta Harga, Minta Detail, Masih Pertimbangkan, Siap Membeli, Tidak Tertarik, Tidak Bisa Dihubungi, Buka Kembali, Lainnya
  notes            String?
  oldStatus        String?
  newStatus        String
  lostReason       String?
  nextFollowUpDate String?
  nextFollowUpTime String?
  createdAt        DateTime @default(now())

  lead             Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sales            User     @relation(fields: [salesId], references: [id])

  @@map("follow_ups")
}

model License {
  id              String          @id @default(cuid())
  licenseKeyHash  String          @unique
  licenseKeyLast4 String
  productCode     String          @default("KEL0LA-LEAD")
  plan            String          @default("lifetime")
  status          String          @default("pending") // pending, active, suspended, revoked
  maxDevices      Int             @default(1)
  isTest          Boolean         @default(false)
  notes           String?
  activatedAt     DateTime?
  lastVerifiedAt  DateTime?
  revokedAt       DateTime?
  expiresAt       DateTime?       // Lifetime = null
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  devices         LicenseDevice[]
  tokens          ActivationToken[]

  @@map("licenses")
}

model LicenseDevice {
  id              String    @id @default(cuid())
  licenseId       String
  deviceId        String
  deviceName      String    @default("Unknown Device")
  browser         String    @default("Unknown Browser")
  operatingSystem String    @default("Unknown OS")
  status          String    @default("active") // active, deactivated
  activatedAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  license         License   @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, deviceId])
  @@map("license_devices")
}

model ActivationToken {
  id         String    @id @default(cuid())
  token      String    @unique
  licenseId  String
  deviceId   String
  issuedAt   DateTime  @default(now())
  expiresAt  DateTime? // Lifetime = null
  createdAt  DateTime  @default(now())

  license    License   @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@map("activation_tokens")
}
